{
  "name": "tavla-visning",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": [
    "chrome > 47"
  ],
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "pnpm exec biome lint ./src",
    "format": "pnpm exec biome format --write ./src",
    "preview": "vite preview",
    "prepare": "husky",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoketest": "node e2e/smoketest.js"
  },
  "lint-staged": {
    "*.{js,ts,tsx,css}": [
      "pnpm exec biome lint --fix ./src",
      "pnpm exec biome format --write ./src"
    ]
  },
  "pnpm": {
    "overrides": {
      "immutable": "3.8.3",
      "shell-quote": "1.8.4"
    },
    "onlyBuiltDependencies": ["esbuild"]
  },
  "dependencies": {
    "@entur/button": "5.0.3",
    "@entur/icons": "10.0.2",
    "@entur/loader": "0.5.35",
    "@entur/tokens": "4.0.1",
    "@entur/typography": "3.0.3",
    "abortcontroller-polyfill": "1.7.8",
    "class-variance-authority": "0.7.1",
    "graphql": "17.0.2",
    "lodash": "4.18.1",
    "nanoid": "6.0.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "swr": "2.3.6",
    "whatwg-fetch": "3.6.20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.3",
    "@graphql-codegen/cli": "7.3.1",
    "@graphql-codegen/import-types-preset": "4.0.1",
    "@graphql-codegen/typed-document-node": "7.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.6",
    "@graphql-typed-document-node/core": "3.2.0",
    "@types/lodash": "4.17.20",
    "@types/node": "26.3.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react-swc": "4.1.0",
    "autoprefixer": "10.4.21",
    "core-js": "3.46.0",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "17.3.0",
    "postcss": "8.5.23",
    "regenerator-runtime": "0.14.1",
    "selenium-webdriver": "4.45.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.8"
  },
  "engines": {
    "pnpm": ">=10.26.0",
    "node": ">=22.13.0"
  }
}
