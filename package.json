{
  "name": "tavla-visning",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": [
    "chrome > 47"
  ],
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "pnpm exec biome lint ./src",
    "format": "pnpm exec biome format --write ./src",
    "preview": "vite preview",
    "prepare": "husky",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoketest": "node e2e/smoketest.js"
  },
  "lint-staged": {
    "*.{js,ts,tsx,css}": [
      "pnpm exec biome lint --fix ./src",
      "pnpm exec biome format --write ./src"
    ]
  },
  "dependencies": {
    "@entur/button": "5.1.1",
    "@entur/icons": "10.0.6",
    "@entur/loader": "0.8.7",
    "@entur/tokens": "4.2.0",
    "@entur/typography": "3.0.7",
    "abortcontroller-polyfill": "1.7.8",
    "class-variance-authority": "0.7.1",
    "graphql": "17.0.2",
    "lodash": "4.18.1",
    "nanoid": "5.1.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "swr": "2.5.1",
    "whatwg-fetch": "3.6.20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@graphql-codegen/cli": "6.1.1",
    "@graphql-codegen/import-types-preset": "4.0.1",
    "@graphql-codegen/typed-document-node": "7.1.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.7",
    "@graphql-typed-document-node/core": "3.2.0",
    "@types/lodash": "4.17.25",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react-swc": "4.3.3",
    "autoprefixer": "10.6.1",
    "core-js": "3.50.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.6.0",
    "postcss": "8.5.28",
    "regenerator-runtime": "0.14.1",
    "selenium-webdriver": "4.49.0",
    "tailwindcss": "3.4.14",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "pnpm": ">=10.26.0",
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}